    # JobPrep — root .gitignore
# Covers both frontend/ (Next.js) and backend/ (FastAPI) since this is a
# single monorepo. frontend/ also has its own .gitignore (from
# create-next-app) which still applies within that folder — this file
# adds root-level and backend coverage on top of it.

# --- OS / editor cruft ---
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Secrets / environment files (both frontend and backend have their own .env) ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Python / FastAPI backend ---
backend/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js frontend (redundant safety net; frontend/.gitignore already covers this within frontend/) ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- Project-specific scratch (per claude/setup-progress.md) ---
_to_delete/
*.tar.gz

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
